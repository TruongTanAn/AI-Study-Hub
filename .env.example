# =========================================
# AI Study Hub - Environment Variables
# =========================================
# Copy this file to .env and adjust as needed

# ---- Application Ports ----
APP_PORT=8080
PMA_PORT=8081
MYSQL_PORT=3306

# ---- Database Configuration ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ai_study_hub
DB_USER=ai_user
DB_PASSWORD=ai_password
DB_ROOT_PASSWORD=root_password

# ---- Application ----
APP_ENV=production
